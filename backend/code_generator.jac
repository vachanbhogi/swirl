"""Generate readable, executable Jac source from a Swirl workflow graph."""

import json;
import from backend.workflow_agent { block_class_for }


walker JacCodeGeneratorWalker {
    has workflow: dict;
    has source: str = "";
    has reports: list[str] = [];

    can generate with Root entry {
        self.source = generate_jac_source(self.workflow);
    }

    can finish with Root exit {
        report self.source;
    }
}


def jac_string(value: str) -> str {
    return json.dumps(value);
}


def jac_dict(value: dict) -> str {
    return json.dumps(value, sort_keys=True);
}


def safe_var(node_id: str) -> str {
    chars: list[str] = [];
    for char in node_id {
        chars.append(char if char.isalnum() else "_");
    }
    name: str = "".join(chars);
    if not name or name[0].isdigit() {
        name = f"n_{name}";
    }
    return f"node_{name}";
}


def generate_jac_source(workflow: dict) -> str {
    nodes: list = workflow.get("nodes", []) as list;
    edges: list = workflow.get("edges", []) as list;
    lines: list[str] = [
        "# Generated by Swirl's JacCodeGeneratorWalker.",
        "import from backend.workflow_agent { WorkflowBlock, SourceBlock, LLMTransformBlock, MacAppBlock, MCPToolBlock, OutputBlock, WorkflowFlow, WorkflowExecutorWalker }",
        "",
        "with entry {",
    ];
    incoming: dict[str, int] = {};
    outgoing: dict[str, list[str]] = {};
    for raw_node in nodes {
        spec: dict = raw_node as dict;
        node_id: str = str(spec.get("id", ""));
        category: str = str(spec.get("category", ""));
        declaration: str = "    " + safe_var(node_id) + " = " + block_class_for(category) + "(";
        declaration += "id=" + jac_string(node_id) + ", ";
        declaration += "block_type=" + jac_string(str(spec.get("type", "unknown"))) + ", ";
        declaration += "title=" + jac_string(str(spec.get("title", node_id))) + ", ";
        declaration += "category=" + jac_string(category) + ", ";
        declaration += "custom_prompt=" + jac_string(str(spec.get("customPrompt", ""))) + ", ";
        declaration += "config=" + jac_dict(spec.get("config", {}) as dict) + ");";
        lines.append(declaration);
        incoming[node_id] = 0;
        outgoing[node_id] = [];
    }
    for raw_edge in edges {
        edge_spec: dict = raw_edge as dict;
        source_id: str = str(edge_spec.get("source", ""));
        target_id: str = str(edge_spec.get("target", ""));
        incoming[target_id] = incoming.get(target_id, 0) + 1;
        outgoing[source_id].append(target_id);
        connection: str = "    " + safe_var(source_id) + " ++> ";
        lines.append(connection + safe_var(target_id) + ";");
    }
    ready: list[str] = [];
    for node_id in incoming {
        if incoming[node_id] == 0 {
            ready.append(node_id);
        }
    }
    ordered: list[str] = [];
    cursor: int = 0;
    while cursor < len(ready) {
        node_id: str = ready[cursor];
        cursor += 1;
        ordered.append(node_id);
        for target_id in outgoing[node_id] {
            incoming[target_id] -= 1;
            if incoming[target_id] == 0 {
                ready.append(target_id);
            }
        }
    }
    if len(ordered) != len(nodes) {
        raise ValueError("Cannot generate Jac source for a cyclic workflow");
    }
    for node_id in ordered {
        lines.append("    root ++> " + safe_var(node_id) + ";");
    }
    lines.append("    result = root spawn WorkflowExecutorWalker();");
    lines.append("    print(result.reports);");
    lines.append("}");
    return "\n".join(lines);
}
